# Gráfico 3: Histogramas facetados por tamaño de empresa
g3 <- ggplot(geih_clean, aes(x = ingreso_hora_real, weight = fex)) +
geom_histogram(bins = 50, fill = "steelblue", alpha = 0.7) +
facet_wrap(~ tamano_empresa, scales = "free_y", ncol = 3) +
scale_x_continuous(
labels = comma,
limits = c(0, quantile(geih_clean$ingreso_hora_real, 0.95))
) +
labs(
title = "Distribución de ingresos por tamaño de empresa",
subtitle = "Histogramas separados para cada categoría de tamaño",
x = "Ingreso por hora (COP 2025)",
y = "Frecuencia"
) +
theme_descriptive +
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 8))
print(g3)
# Gráfico 4: Boxplot de ingresos por tamaño
# Crear muestra para boxplot (más eficiente)
set.seed(123)
sample_boxplot <- geih_clean %>%
filter(ingreso_hora_real < quantile(ingreso_hora_real, 0.99)) %>%
group_by(tamano_empresa) %>%
slice_sample(n = min(10000, n()), weight_by = fex) %>%
ungroup()
View(geih_clean)
sample_boxplot <- geih_clean %>%
filter(ingreso_hora_real < quantile(ingreso_hora_real, 0.99)) %>%
group_by(tamano_empresa) %>%
slice_sample(n = min(10000, n()), weight_by = fex) %>%
ungroup()
sample_boxplot <- geih_clean %>%
filter(ingreso_hora_real < quantile(ingreso_hora_real, 0.99)) %>%
group_by(tamano_empresa) %>%
slice_sample(n = min(10000, n(100)), weight_by = fex) %>%
ungroup()
# Gráfico 5: Percentiles de ingreso por tamaño
percentiles_by_size <- geih_clean %>%
group_by(tamano_empresa) %>%
summarise(
p10 = weighted_quantile(ingreso_hora_real, fex, 0.10),
p25 = weighted_quantile(ingreso_hora_real, fex, 0.25),
p50 = weighted_quantile(ingreso_hora_real, fex, 0.50),
p75 = weighted_quantile(ingreso_hora_real, fex, 0.75),
p90 = weighted_quantile(ingreso_hora_real, fex, 0.90),
.groups = "drop"
) %>%
pivot_longer(
cols = starts_with("p"),
names_to = "percentil",
values_to = "ingreso"
) %>%
mutate(
percentil = factor(percentil, levels = c("p10", "p25", "p50", "p75", "p90"))
)
g5 <- ggplot(percentiles_by_size, aes(x = tamano_empresa, y = ingreso,
color = percentil, group = percentil)) +
geom_line(linewidth = 1) +
geom_point(size = 2.5) +
scale_y_continuous(labels = comma) +
scale_color_brewer(
palette = "RdYlBu",
labels = c("p10" = "P10", "p25" = "P25", "p50" = "P50 (mediana)",
"p75" = "P75", "p90" = "P90")
) +
labs(
title = "Percentiles de ingreso por tamaño de empresa",
subtitle = "P10, P25, P50, P75 y P90 para cada categoría de tamaño",
x = "Tamaño de empresa",
y = "Ingreso por hora (COP 2025)",
color = "Percentil"
) +
theme_descriptive +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
print(g5)
# Gráfico 6: Evolución temporal de percentiles (Solo vs 101+)
percentiles_time <- geih_clean %>%
filter(tamano_empresa %in% c("Solo", "101+")) %>%
group_by(anio, tamano_empresa) %>%
summarise(
p25 = weighted_quantile(ingreso_hora_real, fex, 0.25),
p50 = weighted_quantile(ingreso_hora_real, fex, 0.50),
p75 = weighted_quantile(ingreso_hora_real, fex, 0.75),
.groups = "drop"
) %>%
pivot_longer(
cols = starts_with("p"),
names_to = "percentil",
values_to = "ingreso"
)
g6 <- ggplot(percentiles_time, aes(x = anio, y = ingreso,
color = interaction(tamano_empresa, percentil),
linetype = percentil,
group = interaction(tamano_empresa, percentil))) +
geom_line(linewidth = 1) +
geom_point(size = 1.5) +
scale_x_continuous(breaks = seq(2008, 2025, by = 2)) +
scale_y_continuous(labels = comma) +
scale_color_manual(
values = c(
"Solo.p25" = "coral", "Solo.p50" = "coral3", "Solo.p75" = "coral4",
"101+.p25" = "steelblue1", "101+.p50" = "steelblue3", "101+.p75" = "steelblue4"
),
labels = c(
"Solo.p25" = "Solo - P25", "Solo.p50" = "Solo - P50", "Solo.p75" = "Solo - P75",
"101+.p25" = "101+ - P25", "101+.p50" = "101+ - P50", "101+.p75" = "101+ - P75"
)
) +
scale_linetype_manual(values = c("p25" = "dotted", "p50" = "solid", "p75" = "dashed")) +
labs(
title = "Evolución de percentiles de ingreso: Solo vs 101+ (2008-2025)",
subtitle = "Comparación de P25, P50 y P75 entre trabajadores solos y grandes empresas",
x = "Año",
y = "Ingreso por hora (COP 2025)",
color = "Tamaño - Percentil",
linetype = "Percentil"
) +
theme_descriptive +
theme(axis.text.x = element_text(angle = 0))
print(g6)
employment_2025 <- geih_clean %>%
filter(anio == 2025) %>%
group_by(tamano_empresa) %>%
summarise(
trabajadores = sum(fex, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
porcentaje = 100 * trabajadores / sum(trabajadores)
)
g7 <- ggplot(employment_2025, aes(x = tamano_empresa, y = trabajadores, fill = tamano_empresa)) +
geom_col(alpha = 0.8) +
geom_text(
aes(label = paste0(format(round(trabajadores/1000), big.mark = ","), "k\n",
round(porcentaje, 1), "%")),
vjust = -0.3,
size = 3.5
) +
scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.1))) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Distribución del empleo por tamaño de empresa (2025)",
subtitle = "Número de trabajadores y porcentaje del total",
x = "Tamaño de empresa",
y = "Número de trabajadores (ponderado)"
) +
theme_descriptive +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1)
)
print(g7)
employment_share_time <- geih_clean %>%
group_by(anio, tamano_empresa) %>%
summarise(
trabajadores = sum(fex, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(anio) %>%
mutate(
porcentaje = 100 * trabajadores / sum(trabajadores)
) %>%
ungroup()
g8 <- ggplot(employment_share_time, aes(x = anio, y = porcentaje,
color = tamano_empresa, group = tamano_empresa)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
scale_x_continuous(breaks = seq(2008, 2025, by = 2)) +
scale_y_continuous(labels = function(x) paste0(x, "%")) +
scale_color_brewer(palette = "Set1") +
labs(
title = "Evolución de la participación en el empleo por tamaño (2008-2025)",
subtitle = "Porcentaje del empleo total en cada categoría de tamaño",
x = "Año",
y = "Participación en el empleo (%)",
color = "Tamaño de empresa"
) +
theme_descriptive +
theme(axis.text.x = element_text(angle = 0))
print(g8)
# Gráfico 9: Área apilada de distribución de empleo
g9 <- ggplot(employment_share_time, aes(x = anio, y = porcentaje, fill = tamano_empresa)) +
geom_area(alpha = 0.8, position = "stack") +
scale_x_continuous(breaks = seq(2008, 2025, by = 2)) +
scale_y_continuous(labels = function(x) paste0(x, "%")) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Composición del empleo por tamaño de empresa (2008-2025)",
subtitle = "Área apilada al 100%",
x = "Año",
y = "Participación en el empleo (%)",
fill = "Tamaño de empresa"
) +
theme_descriptive +
theme(axis.text.x = element_text(angle = 0))
print(g9)
# Calcular número de "empresas" implícitas dividiendo empleo entre punto medio del rango
size_midpoints <- c(
"Solo" = 1,
"2-3" = 2.5,
"4-5" = 4.5,
"6-10" = 8,
"11-19" = 15,
"20-30" = 25,
"31-50" = 40,
"51-100" = 75,
"101+" = 150  # Asumiendo promedio de 150 para empresas grandes
)
implied_firms <- employment_2025 %>%
mutate(
tamano_medio = size_midpoints[as.character(tamano_empresa)],
num_empresas = trabajadores / tamano_medio
)
g10 <- ggplot(implied_firms, aes(x = tamano_empresa, y = num_empresas, fill = tamano_empresa)) +
geom_col(alpha = 0.8) +
geom_text(
aes(label = format(round(num_empresas), big.mark = ",")),
vjust = -0.3,
size = 3.5
) +
scale_y_continuous(labels = comma, expand = expansion(mult = c(0, 0.1))) +
scale_fill_brewer(palette = "Set3") +
labs(
title = "Número implícito de empresas por categoría de tamaño (2025)",
subtitle = "Calculado dividiendo empleo entre punto medio del rango de tamaño",
x = "Tamaño de empresa",
y = "Número estimado de empresas"
) +
theme_descriptive +
theme(
legend.position = "none",
axis.text.x = element_text(angle = 45, hjust = 1)
)
print(g10)
employment_income_time <- geih_clean %>%
group_by(anio, tamano_empresa) %>%
summarise(
trabajadores = sum(fex, na.rm = TRUE),
ingreso_medio = weighted_mean(ingreso_hora_real, fex),
.groups = "drop"
)
g11 <- ggplot(employment_income_time, aes(x = trabajadores, y = ingreso_medio,
color = tamano_empresa)) +
geom_point(size = 2.5, alpha = 0.7) +
geom_path(aes(group = tamano_empresa), alpha = 0.3) +
scale_x_continuous(labels = comma) +
scale_y_continuous(labels = comma) +
scale_color_brewer(palette = "Set1") +
labs(
title = "Relación entre empleo e ingreso promedio por tamaño (2008-2025)",
subtitle = "Cada punto representa un año para cada tamaño de empresa",
x = "Número de trabajadores",
y = "Ingreso promedio por hora (COP 2025)",
color = "Tamaño de empresa"
) +
theme_descriptive
print(g11)
# Preparar datos para pirámides (Solo, 11-19, 101+)
piramide_data <- geih_clean %>%
filter(
tamano_empresa %in% c("Solo", "11-19", "101+"),
anio == 2025,
edad >= 18,
edad <= 65
) %>%
mutate(
edad_grupo = cut(edad, breaks = seq(15, 70, by = 5), include.lowest = TRUE)
) %>%
group_by(tamano_empresa, genero, edad_grupo) %>%
summarise(
poblacion = sum(fex, na.rm = TRUE),
.groups = "drop"
) %>%
group_by(tamano_empresa) %>%
mutate(
poblacion = ifelse(genero == "Hombre", -poblacion, poblacion),
porcentaje = 100 * poblacion / sum(abs(poblacion))
) %>%
ungroup()
g12 <- ggplot(piramide_data, aes(x = edad_grupo, y = porcentaje, fill = genero)) +
geom_col() +
coord_flip() +
facet_wrap(~ tamano_empresa, ncol = 3) +
scale_y_continuous(
labels = function(x) paste0(abs(x), "%"),
breaks = seq(-15, 15, 5)
) +
scale_fill_manual(values = c("Hombre" = "steelblue", "Mujer" = "coral")) +
labs(
title = "Pirámides de edad por tamaño de empresa (2025)",
subtitle = "Comparación: Solo, 11-19 trabajadores, y 101+",
x = "Grupo de edad",
y = "Porcentaje de trabajadores",
fill = "Género"
) +
theme_descriptive
print(g12)
