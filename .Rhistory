limpiar_depto_key <- function(x) {
stringi::stri_trans_general(
stringr::str_squish(as.character(x)),
"Latin-ASCII"
) |>
stringr::str_to_lower() |>
stringr::str_replace_all("[^a-z0-9]+", " ") |>
stringr::str_squish()
}
nombres_deptos_ocupados <- c(
"antioquia"           = "Antioquia",
"valle del cauca"     = "Valle del Cauca",
"bogota d c"          = "Bogotá D.C.",
"atlantico"           = "Atlántico",
"santander"           = "Santander",
"caldas"              = "Caldas",
"risaralda"           = "Risaralda",
"bolivar"             = "Bolívar",
"tolima"              = "Tolima",
"meta"                = "Meta",
"norte de santander"  = "Norte de Santander",
"narino"              = "Nariño",
"cordoba"             = "Córdoba"
)
deptos_ocupados <- names(nombres_deptos_ocupados)
geih %>%
mutate(depto_key = limpiar_depto_key(depto_label)) %>%
distinct(depto_label, depto_key) %>%
arrange(depto_key) %>%
print(n = 100)
tabla_ocupados_depto_long <- geih %>%
filter(
!is.na(anio),
anio >= 2010,
anio <= 2025,
!is.na(fex),
fex > 0,
!is.na(depto_label)
) %>%
mutate(
depto_key = limpiar_depto_key(depto_label)
) %>%
filter(
depto_key %in% deptos_ocupados
) %>%
group_by(anio, depto_key) %>%
summarise(
observaciones = n(),
ocupados = sum(fex, na.rm = TRUE),
ocupados_millones = ocupados / 1000000,
.groups = "drop"
) %>%
mutate(
departamento = nombres_deptos_ocupados[depto_key]
) %>%
select(
anio,
departamento,
observaciones,
ocupados,
ocupados_millones
) %>%
arrange(departamento, anio)
View(tabla_ocupados_depto_long)
deptos_24_info <- tibble::tribble(
~depto, ~depto_label_24,
5,  "Antioquia",
8,  "Atlántico",
11, "Bogotá D.C.",
13, "Bolívar",
15, "Boyacá",
17, "Caldas",
18, "Caquetá",
19, "Cauca",
20, "Cesar",
23, "Córdoba",
25, "Cundinamarca",
27, "Chocó",
41, "Huila",
44, "La Guajira",
47, "Magdalena",
50, "Meta",
52, "Nariño",
54, "Norte de Santander",
63, "Quindío",
66, "Risaralda",
68, "Santander",
70, "Sucre",
73, "Tolima",
76, "Valle del Cauca"
)
tabla_ocupados_24_long <- geih %>%
mutate(
depto = as.numeric(depto)
) %>%
filter(
!is.na(anio),
anio >= 2013,
anio <= 2025,
!is.na(fex),
fex > 0,
depto %in% deptos_24_info$depto
) %>%
group_by(anio, depto) %>%
summarise(
observaciones = n(),
ocupados = sum(fex, na.rm = TRUE),
ocupados_millones = ocupados / 1000000,
.groups = "drop"
) %>%
left_join(
deptos_24_info,
by = "depto"
) %>%
select(
anio,
depto,
departamento = depto_label_24,
observaciones,
ocupados,
ocupados_millones
) %>%
arrange(depto, anio)
View(tabla_ocupados_24_long)
table(tabla_ocupados_24_long)
table(tabla_ocupados_24_long$depto)
